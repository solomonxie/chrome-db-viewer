<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>dbui runner</title>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <!-- Per-user install: no admin password, everything goes under ~/Library. -->
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <choices-outline>
    <line choice="default"><line choice="com.dbui.runner"/></line>
  </choices-outline>
  <choice id="default"/>
  <choice id="com.dbui.runner" visible="false">
    <pkg-ref id="com.dbui.runner"/>
  </choice>
  <pkg-ref id="com.dbui.runner" version="__VERSION__" onConclusion="none">dbui-runner-component.pkg</pkg-ref>
</installer-gui-script>
